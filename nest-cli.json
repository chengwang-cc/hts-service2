{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "modules/**/data/**/*.json", "outDir": "dist", "watchAssets": true },
      { "include": "modules/**/data/**/*.csv",  "outDir": "dist", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
