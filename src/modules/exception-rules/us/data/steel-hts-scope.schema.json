{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SteelHtsScope",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "sourceDocuments": { "type": "array", "items": { "type": "string" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["htsCode", "effectiveFrom", "source"],
        "properties": {
          "htsCode": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2,4}$|^\\d{10}$" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "source": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
