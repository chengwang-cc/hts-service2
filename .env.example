# ai-service is the single source of truth for tariff formulas and calculation.
# hts-service /v1/calculator/formula and /v1/calculator/tariff-rates proxy here.
AI_SERVICE_URL=http://ai-service:3001/v2/tariff
# Optional: only required if the ai-service deployment gates these endpoints.
AI_SERVICE_API_KEY=

# Legacy (kept for backward compatibility — used as fallback when AI_SERVICE_URL is unset)
# TARIFF_FORMULAS_API_URL=https://api.report.chitchats.com/v2/tariff
# TARIFF_FORMULAS_API_KEY=your_tariff_formulas_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Selection (optional)
# Set to 'true' to use Chat Completions API instead of Responses API
# Default: false (uses Responses API, with automatic fallback to Chat Completions on error)
# OPENAI_USE_CHAT_COMPLETIONS=false

# Application Configuration
PORT=3000

# Database Configuration
# Add your database connection details here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hts_service
# DB_USER=postgres
# DB_PASSWORD=password
